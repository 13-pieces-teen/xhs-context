{
  "manifest_version": 3,
  "name": "xhs-context · 收藏上下文",
  "version": "0.4.0",
  "version_name": "0.4.0 prototype",
  "description": "打开收藏夹，一键读取到本机，供 Agent 检索和引用。",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "20": "icons/icon-20.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "读取收藏正文与查看进度"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "page-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
